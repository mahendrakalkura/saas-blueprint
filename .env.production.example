# Production Environment Configuration
# Copy this file to .env.production and fill in your actual values

# Database Configuration
DB_USER=postgres
DB_PASSWORD=change-this-strong-password-123
DB_NAME=saas_production

# Redis Configuration
REDIS_PASSWORD=change-this-redis-password-456

# JWT Configuration
JWT_SECRET=change-this-to-a-long-random-string-min-32-chars

# Stripe Configuration
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Resend Email Configuration
RESEND_API_KEY=re_your_resend_api_key

# MinIO Storage Configuration
STORAGE_ACCESS_KEY_ID=minio-access-key
STORAGE_SECRET_ACCESS_KEY=minio-secret-key-change-this

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=https://yourdomain.com/api/v1/auth/google/callback

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URL=https://yourdomain.com/api/v1/auth/github/callback

# Frontend Configuration
FRONTEND_URL=https://yourdomain.com
VITE_API_URL=/api

# Grafana Configuration
GRAFANA_PASSWORD=change-this-grafana-password

# SSL/TLS (if using custom certificates)
# Place your certificate files in nginx/ssl/
# SSL_CERT_PATH=./nginx/ssl/cert.pem
# SSL_KEY_PATH=./nginx/ssl/key.pem

# Optional: Rate Limiting
RATE_LIMIT_GLOBAL_REQUESTS=100
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTHENTICATED_REQUESTS=1000

# Optional: Email Configuration
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Your SaaS Name

# Optional: Stripe Trial Configuration
STRIPE_TRIAL_DAYS=14
